{
    "cli": {
        "version": ">= 14.7.1",
        "appVersionSource": "local"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal"
        },
        "preview": {
            "android": {
                "buildType": "apk"
            },
            "distribution": "internal"
        },
        "production": {
            "autoIncrement": true,
            "env": {
                "SENTRY_ALLOW_FAILURE": "true"
            },
            "android": {
                "buildType": "app-bundle"
            },
            "distribution": "store"
        }
    },  
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6790424891"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
